# Copier en .env.local (jamais commité) et remplir.
# Local : valeurs de `supabase status`. Distant : dashboard Supabase, Settings → API.
# Seule la clé anon va ici : jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salon affiché par le site : id (uuid) d'une ligne de public.salons.
# Local, avec le seed : 11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_SALON_ID=
