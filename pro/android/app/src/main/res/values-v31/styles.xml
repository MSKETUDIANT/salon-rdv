<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus (#41) : écran de démarrage du système, fond de la
     charte et icône adaptative de l'app. Même rendu en mode sombre : l'app est
     en mode clair seulement en v1. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fond</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fond</item>
    </style>
</resources>
